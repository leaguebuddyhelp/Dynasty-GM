{
  "name": "leaguebuddy-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "start:dev": "NODE_ENV=development APP_ENV=dev dotenv_config_path=.env.dev node app.js",
    "start:prod": "NODE_ENV=production APP_ENV=prod dotenv_config_path=.env.prod node app.js",
    "deploy-commands": "node deploy-commands.js",
    "deploy:dev": "NODE_ENV=development APP_ENV=dev dotenv_config_path=.env.dev node deploy-commands.js",
    "deploy:prod": "NODE_ENV=production APP_ENV=prod dotenv_config_path=.env.prod node deploy-commands.js",
    "test": "node scripts/run-tests.js",
    "check:commands": "node deploy-commands.js --dry-run"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^16.6.1",
    "node-fetch": "^3.3.2",
    "sharp": "^0.34.5"
  }
}
